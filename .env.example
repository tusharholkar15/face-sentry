# FaceSentry System Environment Configuration

# API Server Configuration
FACESENTRY_API_HOST=127.0.0.1
FACESENTRY_API_PORT=8000
FACESENTRY_LOG_LEVEL=INFO
FACESENTRY_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration
FACESENTRY_DATABASE_PATH=./data/facesentry.db

# Agent Hardware & Verification Policy Defaults
FACESENTRY_CAMERA_INDEX=0
FACESENTRY_ABSENCE_TIMEOUT_SECONDS=10
FACESENTRY_UNKNOWN_FACE_TIMEOUT_SECONDS=5
FACESENTRY_SPOOF_LOCK_TIMEOUT_SECONDS=0
FACESENTRY_SIMILARITY_THRESHOLD=0.65
FACESENTRY_LIVENESS_THRESHOLD=0.75

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000/ws
